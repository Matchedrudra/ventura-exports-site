# ─────────────────────────────────────────────────────────────
# Ventura Exports — enquiry email configuration
# Copy this file to `.env` for local development, and add the
# same variables in the Vercel project dashboard for production.
# Never commit real keys.
# ─────────────────────────────────────────────────────────────

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender. The domain (venturaexports.in) must be verified
# in Resend before mail will deliver. Until then you may use
# "Ventura Exports <onboarding@resend.dev>" for testing.
ENQUIRY_FROM="Ventura Exports <enquiries@venturaexports.in>"

# Where enquiries are delivered.
ENQUIRY_TO=rudra@venturaexports.in

# Optional: comma-separated additional recipients (CC).
ENQUIRY_CC=

# Optional: shared secret required from the client. If set, the
# frontend must send the same value in the `x-ventura-token` header.
# Leave blank to disable.
ENQUIRY_TOKEN=
